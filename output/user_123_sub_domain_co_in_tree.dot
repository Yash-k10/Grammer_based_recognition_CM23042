digraph ParseTree {
    rankdir=TB;
    node [shape=box, style="filled,rounded", fontname="Helvetica, Arial, sans-serif", fontsize=11, margin="0.2,0.1"];
    edge [color="#64748B", penwidth=1.5, arrowhead=vee];
    bgcolor="transparent";
    node_0 [label="EMAIL", fillcolor="#1E293B", fontcolor="#FFFFFF"];
