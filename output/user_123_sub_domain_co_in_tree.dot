    node_1 -> node_3;
    node_4 [label="WORD\n'123'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_1 -> node_4;
    node_0 -> node_1;
    node_5 [label="AT\n'@'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_0 -> node_5;
    node_6 [label="DOMAIN", fillcolor="#3B82F6", fontcolor="#FFFFFF"];
    node_7 [label="WORD\n'sub'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_6 -> node_7;
    node_8 [label="HYPHEN\n'-'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_6 -> node_8;
    node_9 [label="WORD\n'domain'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_6 -> node_9;
    node_10 [label="DOT\n'.'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_6 -> node_10;
    node_11 [label="WORD\n'co'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_6 -> node_11;
    node_0 -> node_6;
    node_12 [label="DOT\n'.'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_0 -> node_12;
    node_13 [label="TLD\n'in'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_0 -> node_13;
}