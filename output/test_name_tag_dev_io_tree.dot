digraph ParseTree {
    rankdir=TB;
    node [shape=box, style="filled,rounded", fontname="Helvetica, Arial, sans-serif", fontsize=11, margin="0.2,0.1"];
    edge [color="#64748B", penwidth=1.5, arrowhead=vee];
    bgcolor="transparent";
    node_0 [label="EMAIL", fillcolor="#1E293B", fontcolor="#FFFFFF"];
    node_1 [label="LOCAL", fillcolor="#3B82F6", fontcolor="#FFFFFF"];
    node_2 [label="WORD\n'test'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_1 -> node_2;
    node_3 [label="SEP\n'.'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_1 -> node_3;
    node_4 [label="WORD\n'name'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_1 -> node_4;
    node_5 [label="SEP\n'+'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_1 -> node_5;
    node_6 [label="WORD\n'tag'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_1 -> node_6;
    node_0 -> node_1;
    node_7 [label="AT\n'@'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_0 -> node_7;
    node_8 [label="DOMAIN", fillcolor="#3B82F6", fontcolor="#FFFFFF"];
    node_9 [label="WORD\n'dev'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_8 -> node_9;
    node_0 -> node_8;
    node_10 [label="DOT\n'.'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_0 -> node_10;
    node_11 [label="TLD\n'io'", fillcolor="#10B981", fontcolor="#FFFFFF", shape=ellipse];
    node_0 -> node_11;
}